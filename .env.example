# ---------------------------------------------------------------------------
# Manju Sensei — Teacher's Resource Hub
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# On Netlify, add the same keys under Site configuration -> Environment variables.
# ---------------------------------------------------------------------------

# Supabase project URL — Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key — safe in the browser because Row Level Security
# guards every table and bucket. Never use the service_role key here.
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google AI Studio key for Sleep Sensei — https://aistudio.google.com/apikey
# Leave blank to run the site with the assistant disabled.
VITE_GEMINI_API_KEY=

# Optional. Defaults to the automatic chain gemini-2.5-flash -> gemini-2.0-flash.
# VITE_GEMINI_MODEL=gemini-2.5-flash
