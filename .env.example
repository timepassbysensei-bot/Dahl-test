# View Point Public School - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# Your Supabase project URL
# Found in: Supabase Dashboard > Settings > API
# Format: https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous (public) key
# Found in: Supabase Dashboard > Settings > API > Project API keys > anon public
# This key is safe to expose in the browser - it respects RLS policies
# NEVER use the service_role key here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# SITE CONFIGURATION
# =============================================================================

# The deployed site URL (no trailing slash)
# Used for OAuth redirects, email links, and canonical URLs
# Example: https://viewpoint-public-school.netlify.app
VITE_SITE_URL=https://your-domain.com

# School name displayed throughout the application
VITE_SCHOOL_NAME=View Point Public School

# =============================================================================
# OPTIONAL: ADDITIONAL CONFIGURATION
# =============================================================================

# Application environment
# Options: development, production, staging
VITE_APP_ENV=development

# Enable debug mode (logs additional information)
# Set to false in production
VITE_DEBUG_MODE=false

# =============================================================================
# IMPORTANT SECURITY NOTES
# =============================================================================
# 
# 1. The VITE_SUPABASE_ANON_KEY is designed to be exposed in the browser.
#    Row Level Security (RLS) policies on your Supabase tables control access.
#
# 2. NEVER expose your Supabase service_role key in the browser.
#    Service role keys bypass RLS and should only be used in secure server
#    environments or Supabase Edge Functions.
#
# 3. All sensitive operations (like approving teacher registrations) must be
#    handled through Supabase Edge Functions or RPC functions that verify
#    the user's role server-side.
#
# 4. Keep your .env file out of version control by adding it to .gitignore.
#
# 5. In Netlify, set these environment variables in the dashboard:
#    Site > Environment variables
#
# =============================================================================
# 
# For Supabase Edge Functions (if using server-side operations):
# Add these to netlify.toml or Netlify dashboard, NOT in .env for browser:
#
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# 
# =============================================================================
# 
# To get your Supabase credentials:
# 1. Go to https://supabase.com
# 2. Create a new project or select existing one
# 3. Go to Settings > API
# 4. Copy the Project URL and anon/public key
#
# =============================================================================
# 
# After setting up your .env file, run:
# npm install
# npm run dev
#
# =============================================================================